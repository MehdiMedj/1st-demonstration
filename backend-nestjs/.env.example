# NestJS variant — connects to the SAME Postgres/PostGIS + Redis as the FastAPI
# backend. Run only ONE backend's migrations against a given database.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=fleetos
DATABASE_PASSWORD=fleetos
DATABASE_NAME=fleetos

REDIS_URL=redis://localhost:6379/0
TELEMETRY_CHANNEL=fleetos:telemetry

PORT=8000
API_V1_PREFIX=api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
