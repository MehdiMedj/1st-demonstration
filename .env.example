# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=fleetos
POSTGRES_PASSWORD=fleetos
POSTGRES_DB=fleetos
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async URL used by the app (asyncpg). Compose overrides host to the `db` service.
DATABASE_URL=postgresql+asyncpg://fleetos:fleetos@db:5432/fleetos
# Sync URL used by Alembic migrations (psycopg).
DATABASE_URL_SYNC=postgresql+psycopg://fleetos:fleetos@db:5432/fleetos

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
TELEMETRY_CHANNEL=fleetos:telemetry

# ─── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins for the dashboard.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws/telemetry
# Demo tenant used by the dashboard until real auth is wired up.
NEXT_PUBLIC_ORG_ID=00000000-0000-0000-0000-000000000001
